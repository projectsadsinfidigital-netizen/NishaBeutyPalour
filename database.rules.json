{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === 'bpmWl49HuMhQnvsXaHF86yXOd9I2' && $uid === 'bpmWl49HuMhQnvsXaHF86yXOd9I2'",
        "role": {
          ".validate": "newData.val() === 'admin'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bookings": {
      ".read": "auth != null && auth.uid === 'bpmWl49HuMhQnvsXaHF86yXOd9I2'",
      ".indexOn": ["createdAt"],
      "$bookingId": {
        ".write": "(auth != null && auth.uid === 'bpmWl49HuMhQnvsXaHF86yXOd9I2') || (!data.exists() && newData.child('status').val() === 'pending')",
        ".validate": "newData.hasChildren(['name', 'phone', 'service', 'date', 'time', 'status', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 7 && newData.val().length <= 20"
        },
        "service": {
          ".validate": "newData.val() === 'haircut' || newData.val() === 'facial' || newData.val() === 'makeup' || newData.val() === 'spa'"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().length === 10"
        },
        "time": {
          ".validate": "newData.isString() && newData.val().length === 5"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'confirmed' || newData.val() === 'cancelled'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && auth.uid === 'bpmWl49HuMhQnvsXaHF86yXOd9I2'",
        ".validate": "newData.hasChildren(['name', 'description', 'price', 'category', 'imageUrl', 'isAvailable', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "imageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "isAvailable": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "inquiries": {
      ".read": "auth != null && auth.uid === 'bpmWl49HuMhQnvsXaHF86yXOd9I2'",
      ".indexOn": ["createdAt"],
      "$inquiryId": {
        ".write": "(auth != null && auth.uid === 'bpmWl49HuMhQnvsXaHF86yXOd9I2') || (!data.exists() && newData.child('status').val() === 'new')",
        ".validate": "newData.hasChildren(['name', 'phone', 'message', 'status', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 7 && newData.val().length <= 20"
        },
        "productId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "productName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "status": {
          ".validate": "newData.val() === 'new' || newData.val() === 'resolved'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
